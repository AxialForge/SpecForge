{
  "name": "specforge",
  "productName": "SpecForge",
  "version": "0.1.0",
  "description": "Scan a Windows PC's hardware and software and export the specs for AI-written marketplace listings or audits.",
  "main": "src/main/main.js",
  "author": "AxialForge",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/AxialForge/SpecForge",
  "repository": {
    "type": "git",
    "url": "https://github.com/AxialForge/SpecForge.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"test/**/*.test.js\"",
    "build:win": "electron-builder --win",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "systeminformation": "^5.33.8"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@44.2.0": true,
    "electron-winstaller@5.4.0": true
  }
}
